<?xml version="1.0" encoding="utf-8" ?>
<!--
  Logging for ADUtils.

  Everything is written under a "logs" folder next to ADUtils.exe (${basedir}), so a copied or
  ClickOnce-deployed build keeps its own logs and needs no mapped drive to be present.

  Three separate files, because they answer different questions:
    audit-*.log  - what privileged change was made, by whom. The record that matters.
    error-*.log  - exceptions with stack traces. Previously these only ever reached the console.
    adutils-*.log - everything, for tracing a session end to end.

  internalLogFile captures NLog's own startup problems; without it a misconfigured target
  fails silently and you get no logs at all with no explanation.

  throwConfigExceptions is deliberately false: a logging misconfiguration must not take down a
  tool that performs privileged AD changes. Program.Main checks at startup that the config
  actually loaded and warns loudly if it did not, so this fails visibly rather than silently.

  Note for editing: properties removed in NLog 6 (concurrentWrites, for one) are silently
  rejected and abort the whole config. After changing this file, check logs/nlog-internal.log.
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      throwConfigExceptions="false"
      internalLogLevel="Warn"
      internalLogFile="${basedir}/logs/nlog-internal.log">

  <variable name="logDir" value="${basedir}/logs" />

  <!-- Audit lines are read by people, so keep them plain. Diagnostic lines carry the detail. -->
  <variable name="auditLayout" value="${longdate} | ${event-properties:item=admin:whenEmpty=unknown} | ${message}" />
  <variable name="diagLayout"  value="${longdate} | ${uppercase:${level}:padding=-5} | ${logger:shortName=true} | ${message}${onexception:${newline}${exception:format=ToString}}" />

  <targets async="true">

    <target xsi:type="File"
            name="auditFile"
            fileName="${logDir}/audit-${shortdate}.log"
            layout="${auditLayout}"
            encoding="utf-8"
            keepFileOpen="true"
            archiveAboveSize="10485760"
            maxArchiveFiles="30" />

    <target xsi:type="File"
            name="errorFile"
            fileName="${logDir}/error-${shortdate}.log"
            layout="${diagLayout}"
            encoding="utf-8"
            keepFileOpen="true"
            archiveAboveSize="10485760"
            maxArchiveFiles="30" />

    <target xsi:type="File"
            name="allFile"
            fileName="${logDir}/adutils-${shortdate}.log"
            layout="${diagLayout}"
            encoding="utf-8"
            keepFileOpen="true"
            archiveAboveSize="10485760"
            maxArchiveFiles="14" />

  </targets>

  <rules>
    <!-- The audit trail. final="true" keeps audit entries out of the diagnostic files so the
         record of privileged changes stays in one place. -->
    <logger name="ADUtils.Audit" minlevel="Info" writeTo="auditFile" final="true" />

    <logger name="*" minlevel="Warn" writeTo="errorFile" />

    <!-- Debug so this is a full session trace: prompts and menu text included, which is what
         makes it possible to reconstruct what an operator actually did. Raise to Info if the
         volume becomes a problem. -->
    <logger name="*" minlevel="Debug" writeTo="allFile" />
  </rules>
</nlog>
